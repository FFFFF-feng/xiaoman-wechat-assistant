APP_ENV=local
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./data/tasks.db
MODEL_ENABLED=false
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=qwen3.8-flash
# 阿里云百炼推荐直接配置下面两项；程序会自动使用官方兼容地址
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-flash
# 也兼容 ALIYUN_API_KEY、API_KEY，以及 OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_MODEL
CHAT_HISTORY_LIMIT=10
REMINDER_CHECK_SECONDS=5

# 微信公众号；测试号默认兼容，正式号请参考 .env.official.example 和 docs/正式公众号接入.md
WECHAT_ENABLED=false
# test 保持原测试号的用户命名；official 隔离 AppID，并启用客服窗口/额度保护
WECHAT_ACCOUNT_MODE=test
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
# 可选但建议正式号填写 gh_ 开头的原始 ID，防止接错公众号
WECHAT_ORIGINAL_ID=
# plain 明文；compatible 兼容；safe 安全。必须与平台配置一致，正式号推荐 safe
WECHAT_ENCRYPTION_MODE=plain
WECHAT_ENCODING_AES_KEY=
# auto：有 AppID/Secret 时异步客服消息回复，否则使用被动 XML 回复
WECHAT_REPLY_MODE=auto
# 微信客服异步消息的 AI 标识；设为 true 可使用官方的灰色 AI 标识
WECHAT_AI_LABEL=false
# customer 仅客服窗口内；template 传统服务号模板；subscribe 用户授权的订阅通知
WECHAT_REMINDER_MODE=customer
# 以下 JSON 的字段名必须来自本账号的真实模板，不能直接照抄示例
WECHAT_TEMPLATE_ID=
WECHAT_TEMPLATE_DATA=
WECHAT_SUBSCRIBE_ID=
WECHAT_SUBSCRIBE_DATA=
# 服务离线过久后不补发旧微信提醒；默认超过 1 小时只在本地记录为 missed
WECHAT_REMINDER_MAX_LATENESS_SECONDS=3600
# 微信内日程页公网地址；Cloudflare 临时隧道回调可自动识别，固定域名时请显式填写 HTTPS 地址
PUBLIC_BASE_URL=

# 微信对话开放平台第三方服务接口
WECHAT_DIALOGUE_ENABLED=false
# 在平台“第三方服务接口”中自定义并与本地保持一致
WECHAT_DIALOGUE_TOKEN=
# 平台开启请求/响应加密后填写 43 位 EncodingAESKey；明文联调可留空
WECHAT_DIALOGUE_AES_KEY=
WECHAT_DIALOGUE_REQUIRE_ENCRYPTION=false
# 请求时间与服务器时间允许的最大偏差（秒）；设为 0 可关闭检查
WECHAT_DIALOGUE_MAX_SKEW_SECONDS=300
# 微信平台第三方服务接口通常要求 2 秒内同步返回；只有替换为低时延模型时才开启。
WECHAT_DIALOGUE_FAST_MODEL_ENABLED=false
