# 正式号配置模板：复制所需项到服务器已有 .env，切勿覆盖/上传真实密钥。
APP_ENV=production
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./data/tasks.db
PUBLIC_BASE_URL=https://example.com
MODEL_ENABLED=true
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-flash
CHAT_HISTORY_LIMIT=10
REMINDER_CHECK_SECONDS=5

WECHAT_ENABLED=true
WECHAT_ACCOUNT_MODE=official
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ORIGINAL_ID=
WECHAT_TOKEN=
WECHAT_ENCRYPTION_MODE=safe
WECHAT_ENCODING_AES_KEY=
# AI 处理放到后台，先在微信规定时限内 ACK，随后用客服消息回复
WECHAT_REPLY_MODE=async
WECHAT_AI_LABEL=true
WECHAT_REMINDER_MAX_LATENESS_SECONDS=3600

# 首次联调用 customer；超出48小时不会创建客服提醒，不会自动改成次日。
WECHAT_REMINDER_MODE=customer
# 只有平台确有权限、真实模板匹配业务并完成实测后，再选择 template 或 subscribe。
WECHAT_TEMPLATE_ID=
# 示意字段不是可直接使用的模板；请替换为平台实际字段名。
# WECHAT_TEMPLATE_DATA='{"thing1":{"value":"{title_short}"},"time2":{"value":"{due_at}"}}'
WECHAT_TEMPLATE_DATA=
WECHAT_SUBSCRIBE_ID=
# WECHAT_SUBSCRIBE_DATA='{"thing1":{"value":"{title_short}"},"time2":{"value":"{due_at}"}}'
WECHAT_SUBSCRIBE_DATA=
WECHAT_DIALOGUE_ENABLED=false
