# ClawBot 后端模板。复制为私有 .env.clawbot.local，使用 XIAOMAN_ENV_FILE 显式选择。
# 此模板不是可直接公开运行的配置；绑定和鉴权必须先由部署人员准备。
APP_ENV=clawbot
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./data/clawbot/tasks.db
REMINDER_CHECK_SECONDS=5

MODEL_ENABLED=true
MODEL_NAME=qwen3.8-flash
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
DASHSCOPE_API_KEY=
ALIYUN_API_KEY=
CHAT_HISTORY_LIMIT=10
# 原生语音转写可直接进入意图；音频ASR兜底需单独启用，会将音频发送百炼并计费。
ASR_ENABLED=false
ASR_MODEL=qwen3-asr-flash
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=

# 主动发送的图片/文件/记录只读整理，使用现有百炼模型配置；不自动创建提醒。
CLAWBOT_MATERIALS_ENABLED=true
# 图片需要支持视觉输入的模型，文本文件沿用MODEL_NAME。
VISION_MODEL=qwen3.8-flash

# 接口鉴权值须与连接器 tokenFile 文件一致，不是微信 Token 或 AppSecret。
CLAWBOT_ENABLED=true
CLAWBOT_BRIDGE_TOKEN=
# 部署人员填写真实的私有绑定文件绝对路径，不能从用户消息中获取身份。
CLAWBOT_BINDINGS_FILE=
CLAWBOT_REMINDERS_ENABLED=true
CLAWBOT_REMINDER_MAX_LATENESS_SECONDS=300
# 新的分级提前提醒与进度询问需部署验收后显式开启，缺省false保留原有到点提醒。
# high: 提前20/10分钟、到点、最多2次进度询问；normal: 提前10分钟、到点、最多1次；low: 仅到点。
# 自动额外提醒在22:00—08:00休息；用户明确约定的到点或稍后提醒照常。
CLAWBOT_FOLLOWUPS_ENABLED=false
# 原创PNG按图片发送；ClawBot启用后，表情默认自动开启，无次数/冷却限制。
# 现有和新绑定缺省开启，保留本人主动关闭的设置；“关闭表情包”暂停，“开启表情包”恢复。
# 显式false可停用整个表情功能；关闭用户指令仍可保存。
CLAWBOT_STICKERS_ENABLED=true
# 发布新版本时自动向当时已绑定的老用户推送一次；新用户使用独立欢迎指南。
# 通过web/releases.json的版本号去重，重启不补发；false可暂停更新推送。
CLAWBOT_ANNOUNCEMENTS_ENABLED=true
# 邀请制多人接入，需要单独启动官方 CLI 登录 worker。默认关闭防止误开放。
CLAWBOT_ENROLLMENT_ENABLED=false
CLAWBOT_MAX_USERS=10
# 独立管理密码哈希文件，由setup-clawbot-admin.py生成；不填写微信或桥接密钥。
CLAWBOT_ADMIN_AUTH_FILE=
# 固定 HTTPS 地址示例，必须替换为自己的已部署日程域名。
PUBLIC_BASE_URL=https://schedule.example.com
# 固定域名部署不要沿用本机临时隧道的心跳文件。
CLAWBOT_PUBLIC_URL_FILE=

# 与现有公众号配置彻底分开，不导入公众号凭据。
WECHAT_ENABLED=false
WECHAT_DIALOGUE_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
