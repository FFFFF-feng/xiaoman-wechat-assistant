{
  "id": "xiaoman-bridge",
  "name": "Xiaoman Python bridge",
  "description": "Claims trusted Weixin text and bounded voice messages for the isolated local Xiaoman service.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["backendUrl", "tokenFile", "bindingsFile"],
    "properties": {
      "backendUrl": { "type": "string", "const": "http://127.0.0.1:18083" },
      "tokenFile": { "type": "string", "minLength": 1 },
      "bindingsFile": { "type": "string", "minLength": 1 },
      "mergeTextMessages": { "type": "boolean", "default": false }
    }
  }
}
